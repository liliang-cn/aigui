{
  "name": "aigui",
  "private": true,
  "description": "AIGUI — framework-agnostic SDK for rendering streaming LLM output (markdown, cards, charts, math, diagrams) in React, Vue, and vanilla JS.",
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:release": "node --test scripts/release-tag.test.mjs",
    "typecheck": "turbo run typecheck",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:playground": "pnpm --filter @ai-gui/playground build",
    "validate:release-tag": "node scripts/release-tag.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm typecheck && pnpm test:unit && pnpm validate:packages && pnpm validate:playground && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "^2.1.0",
    "publint": "^0.3.0",
    "tsdown": "^0.9.0",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "openclaw": "2026.7.1"
    }
  }
}
