{
  "name": "@aigui/plugin-mermaid",
  "version": "0.1.0",
  "description": "Mermaid diagram plugin for AIGUI.",
  "keywords": [
    "llm",
    "ai",
    "streaming",
    "markdown",
    "mermaid",
    "diagram",
    "flowchart",
    "plugin",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/plugin-mermaid"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
