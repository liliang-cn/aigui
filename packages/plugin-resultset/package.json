{
  "name": "@ai-gui/plugin-resultset",
  "version": "0.34.0",
  "description": "Host-owned result tables for AIGUI: the numbers in an answer come from the query, not from the model retyping them.",
  "keywords": [
    "llm",
    "ai",
    "sql",
    "table",
    "provenance",
    "markdown",
    "plugin",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/plugin-resultset"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm --dir ../.. exec vitest run --project plugin-resultset",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-gui/core": "workspace:*"
  }
}
