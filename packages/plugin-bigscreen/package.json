{
  "name": "@ai-gui/plugin-bigscreen",
  "version": "0.35.0",
  "description": "Animated data walls for AIGUI — counting KPIs, sweeping gauges, growing ranks, self-drawing charts, turning 3D bars and globes, on a grid the model lays out.",
  "keywords": [
    "llm",
    "ai",
    "dashboard",
    "big-screen",
    "data-wall",
    "echarts",
    "echarts-gl",
    "3d",
    "animation",
    "plugin",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/plugin-bigscreen"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm --dir ../.. exec vitest run --project plugin-bigscreen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-gui/core": "workspace:*",
    "echarts": "^5.5.1"
  },
  "peerDependencies": {
    "echarts-gl": "^2.0.9"
  },
  "peerDependenciesMeta": {
    "echarts-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "echarts-gl": "^2.0.9"
  }
}
