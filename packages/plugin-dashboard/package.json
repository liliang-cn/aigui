{
  "name": "@ai-gui/plugin-dashboard",
  "version": "0.32.0",
  "description": "BI dashboard plugin for AIGUI — a grid of panels, each a table + ECharts chart + provenance, with per-panel refusals. The host writes every number; the model only proposes the layout.",
  "keywords": [
    "llm",
    "ai",
    "bi",
    "dashboard",
    "echarts",
    "resultset",
    "provenance",
    "plugin",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/plugin-dashboard"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm --dir ../.. exec vitest run --project plugin-dashboard",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-gui/core": "workspace:*",
    "echarts": "^5.5.1"
  }
}
