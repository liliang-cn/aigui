{
  "name": "@aigui/vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter for AIGUI — stream LLM output into live Vue components with cards and plugins.",
  "keywords": [
    "llm",
    "ai",
    "streaming",
    "markdown",
    "vue",
    "vue3",
    "components",
    "cards",
    "aigui"
  ],
  "license": "MIT",
  "author": "Liang Li <ll_faw@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliang-cn/aigui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/liliang-cn/aigui#readme",
  "bugs": "https://github.com/liliang-cn/aigui/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aigui/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.12",
    "@vue/test-utils": "^2.4.6"
  }
}
